# ─────────────────────────────────────────────────────────────────────────────
# Reyaan Trip Holiday — admin + API configuration
# Copy to `.env` (same folder as this file, OUTSIDE public/) and fill in.
# ─────────────────────────────────────────────────────────────────────────────

APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
# Public URL of THIS admin/API app (no trailing slash)
APP_URL=https://admin.yourdomain.com
# Only if the admin is installed in a sub-folder (e.g. /admin). Leave empty for a subdomain.
APP_BASE_PATH=

# Public URL of the Next.js website (used for image previews + "View website")
WEBSITE_URL=https://yourdomain.com

# ── MySQL (hPanel → Databases → MySQL Databases) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_rth
DB_USER=u123456789_rth
DB_PASS=change-me
# Optional unix socket instead of host/port
DB_SOCKET=

# ── Sessions ──
SESSION_LIFETIME_MINUTES=240
# Force secure cookies (true on HTTPS). Auto-detected when behind HTTPS.
SESSION_SECURE=true
# true only if a proxy/CDN (e.g. Cloudflare) sits in front and sets X-Forwarded-For
TRUST_PROXY=false

# ── First-run owner setup: open https://admin.yourdomain.com/setup?token=<SETUP_TOKEN>
# Use a long random string (≥16 chars). REMOVE it after creating the owner account.
SETUP_TOKEN=

# ── Public API ──
# Shared key the website's server sends as X-RTH-Key (must equal CMS_API_KEY in the website's env).
# Long random string. Optional today (reads are public), reserved for private endpoints.
API_READ_KEY=
# Browser origins allowed to POST enquiries (the website). Comma-separated.
API_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Website cache refresh (must match REVALIDATE_SECRET in the website's environment) ──
NEXT_REVALIDATE_URL=https://yourdomain.com/api/revalidate
NEXT_REVALIDATE_SECRET=change-me-to-a-long-random-string

# ── Uploads ──
UPLOAD_MAX_MB=8

# ── Optional: email a notification for every new enquiry (uses PHP mail()) ──
ENQUIRY_NOTIFY_EMAIL=
MAIL_FROM=no-reply@yourdomain.com
