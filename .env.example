# ─────────────────────────────────────────────────────────────────────────────
# Reyaan Trip Holiday — website (Next.js) environment
# Copy to .env.local (dev) or set in the Hostinger Node.js app settings (prod).
# Every variable is optional: with none set, the site builds and runs from the
# local content in src/data/* and enquiries go to WhatsApp / email only.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the PHP CMS (admin + JSON API), no trailing slash. Server-only.
# The site reads GET ${CMS_API_URL}/api/v1/content (cached, tag "cms").
# Needed at BUILD time too, or the build prerenders from the local fallback data.
# Local dev backend: http://127.0.0.1:8095
CMS_API_URL=https://admin.yourdomain.com

# Shared key sent as the X-RTH-Key header on CMS API requests. Server-only.
# Must equal API_READ_KEY in backend/.env (leave empty if the API is public).
CMS_API_KEY=

# Public CMS base URL used by the browser to save enquiries:
#   POST ${NEXT_PUBLIC_CMS_API_URL}/api/v1/enquiries   (fire-and-forget, never delays WhatsApp)
# Inlined at BUILD time — rebuild after changing it. Leave empty to disable lead saving.
# The CMS must allow this site's origin in API_ALLOWED_ORIGINS (backend/.env).
NEXT_PUBLIC_CMS_API_URL=https://admin.yourdomain.com

# Where admin uploads are served from, for next/image's remotePatterns allow-list.
# Base URL or glob — both work: https://admin.yourdomain.com/uploads  or  https://admin.yourdomain.com/uploads/**
# Read at BUILD time (next.config.ts). If empty, falls back to ${CMS_API_URL}/uploads/**.
CMS_MEDIA_URL=https://admin.yourdomain.com/uploads/**

# Shared secret for POST /api/revalidate (header: x-revalidate-secret). Server-only.
# Must equal NEXT_REVALIDATE_SECRET in backend/.env. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=change-me-to-a-long-random-string
